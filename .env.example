PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://safehome_user:safehome_pass@cluster0.mongodb.net/safehome_rag?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-5-sonnet-20241022
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# SLA Monitoring (in hours)
SLA_LOW_HOURS=72
SLA_MEDIUM_HOURS=48
SLA_HIGH_HOURS=24
SLA_URGENT_HOURS=4
SLA_CHECK_INTERVAL_CRON="0 * * * *"

# Email / Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_FROM=notifications@safehome.local

# ML Image Verification Microservice (optional)
ML_SERVICE_URL=http://localhost:8000
ML_CONFIDENCE_THRESHOLD=0.75

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Twilio SMS / WhatsApp (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
REDIS_URL=redis://localhost:6379
SENTRY_DSN=

# AI copilot agent
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=8192
AGENT_RATE_LIMIT_MAX=120

# Neo4j Graph Database
NEO4J_URI=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
